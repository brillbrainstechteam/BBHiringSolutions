# ============================================================
#  BBHS hiring software — settings for this copy.
#  Copy this file to ".env" in the same folder and fill it in.
#  .env is never committed to git. Restart the app after a change.
# ============================================================

# "test" = sample data + a TEST COPY marker on every page. "live" = starts empty.
BBHS_ENV=test
PORT=4600
# Where the database, files and daily backups are kept (default: ./data)
# BBHS_DATA=/var/lib/bbhs-test

# The public web address of this copy, used in WhatsApp links (no slash at the end)
BASE_URL=http://localhost:4600

# ---------- WhatsApp through the BrillBrains CRM ----------
# From the CRM: Settings → Hiring Software (BBHS)
CRM_ENABLED=false
CRM_SEND_URL=https://<crm-address>/api/hiring/send
CRM_TOKEN=
# The same check word typed in the CRM's Hiring Software card
CRM_WEBHOOK_SECRET=

# ---------- Outgoing email (confirmations + new-lead notices) ----------
# Gmail / Google Workspace: smtp.gmail.com, 587, starttls, your address, an App Password
# Zoho: smtp.zoho.in, 465, ssl     Outlook / Microsoft 365: smtp.office365.com, 587, starttls
SMTP_HOST=
SMTP_PORT=587
# ssl (port 465), starttls (port 587) or none (a local relay)
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BrillBrains Hiring <jobs@brillbrainsconsultants.com>
# Who gets an email for every new hiring request and job application (comma separated)
NOTIFY_EMAILS=
# Every WhatsApp message also goes by email to people with an email address (off to stop)
EMAIL_COPIES=on

# ---------- Email inbox door (jobs@ mailbox, IMAP over SSL) ----------
# For Gmail / Google Workspace use an app password (IMAP must be on).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# ---------- Error alerts for the developer ----------
# A Slack, Google Chat or Discord "incoming webhook" link
ALERT_WEBHOOK_URL=

# ---------- Virus scan of uploads (ClamAV daemon) ----------
CLAMD_HOST=
CLAMD_PORT=3310

# ---------- Second copy of the daily backup, off this server ----------
# A mounted drive or a cloud-synced folder (Google Drive, OneDrive, S3 mount …)
BACKUP_DIR=

# Behind Caddy/Nginx (HTTPS) so visitor addresses are read correctly
TRUST_PROXY=false
